# =============================================================================
# NovaTech RAG Agent Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.2

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rapidclaim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password-here

# -----------------------------------------------------------------------------
# RAG Agent Configuration
# -----------------------------------------------------------------------------
# Number of chunks to retrieve per query
DEFAULT_TOP_K=10
# Keep last N exchanges for conversation context
MAX_CONVERSATION_HISTORY=6
# Maximum chunks from any single source (for diversity)
MAX_CHUNKS_PER_SOURCE=2
# Minimum similarity score for retrieved chunks (0-1)
SIMILARITY_THRESHOLD=0.3

# -----------------------------------------------------------------------------
# Chunker Configuration
# -----------------------------------------------------------------------------
# Maximum number of words per chunk
CHUNK_SIZE=500
# Number of overlapping words between consecutive chunks
CHUNK_OVERLAP=100

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
